#!/usr/bin/env python3
"""Stands in for `navi --emacs` in the ERT tests: says hello, appends every
command it reads to $FAKE_NAVI_LOG, and answers a `show` of the id
"open-me" with an `open` event for $FAKE_NAVI_OPEN (FILE:POS:LEVEL)."""
import json, os, sys
log = open(os.environ["FAKE_NAVI_LOG"], "a", buffering=1)
log.write(json.dumps({"argv": sys.argv[1:]}) + "\n")
print(json.dumps({"event": "hello", "version": "9.9.9", "protocol": 1}), flush=True)
for line in sys.stdin:
    cmd = json.loads(line)
    log.write(json.dumps(cmd) + "\n")
    if cmd.get("op") == "show" and cmd.get("id") == "open-me":
        f, pos, level = os.environ["FAKE_NAVI_OPEN"].rsplit(":", 2)
        print(json.dumps({"event": "open", "id": "x", "file": f, "pos": int(pos), "level": int(level)}), flush=True)
    if cmd.get("op") == "quit":
        break
print(json.dumps({"event": "bye"}), flush=True)
